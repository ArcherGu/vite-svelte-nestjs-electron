{
  "name": "vite-svelte-nestjs-electron",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "description": "Vite + Svelte + Electron with Doubleshot, so fast! ⚡",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "rimraf dist && vite",
    "debug": "rimraf dist && vite -- --dsb-debug",
    "build": "rimraf dist && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json",
    "typecheck:node": "tsc -p ./tsconfig.node.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:node",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npx simple-git-hooks && electron-builder install-app-deps"
  },
  "dependencies": {
    "@doubleshot/nest-electron": "^0.2.15",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@lightwing/eslint-config": "^1.0.158",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "lint-staged": "^17.0.8",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.1.4",
    "vite-plugin-doubleshot": "^0.0.26"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json,yml}": [
      "eslint --fix"
    ]
  }
}
