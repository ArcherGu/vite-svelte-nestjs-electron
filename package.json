{
  "name": "vite-svelte-nestjs-electron",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": "Vite + Svelte + Electron with Doubleshot, so fast! \u26a1",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "rimraf dist && vite",
    "debug": "rimraf dist && vite -- --dsb-debug",
    "build": "rimraf dist && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json",
    "typecheck:node": "tsc -p ./tsconfig.node.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:node",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npx simple-git-hooks && electron-builder install-app-deps",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs"
  },
  "dependencies": {
    "@doubleshot/nest-electron": "^0.2.16",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/microservices": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@lightwing/eslint-config": "^1.0.160",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-doubleshot": "^0.0.26"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json,yml}": [
      "eslint --fix"
    ]
  }
}
